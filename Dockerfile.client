# ==============================================================================
# 🌐 FIRMEZA.CLIENT - Dockerfile Producción (Raíz / Contexto de Solución)
# ==============================================================================
FROM node:20-alpine AS build
WORKDIR /app

COPY firmeza.client/package*.json ./
RUN npm ci || npm install

COPY firmeza.client/ ./
RUN npx ng build --output-path=dist/browser --configuration production

FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

COPY firmeza.client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/browser .

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
