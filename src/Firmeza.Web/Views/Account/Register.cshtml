@model RegisterDto
@{
    ViewData["Title"] = "Registrar Administrador - Firmeza";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold">Registro de Administrador</h4>
                <small class="text-white-50">Crear cuenta con privilegios administrativos</small>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post">
                    <input type="hidden" asp-for="Role" value="@Roles.Administrador" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control" placeholder="admin2@firmeza.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Edad" class="form-label fw-semibold">Edad</label>
                        <input asp-for="Edad" class="form-control" placeholder="Ej: 28" type="text" />
                        <div class="form-text small text-muted">Ingrese su edad en años (número entero).</div>
                        <span asp-validation-for="Edad" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg">Registrar</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-decoration-none small">
                    ¿Ya tienes cuenta? Iniciar Sesión
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
