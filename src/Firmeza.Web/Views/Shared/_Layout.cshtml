@using Firmeza.Domain.Constants
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Firmeza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/Firmeza.Web.styles.css" asp-append-version="true"/>
</head>
<body class="bg-light">

@if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Administrador))
{
    <!-- Layout con Navegación Lateral (Administrador) -->
    <div class="sidebar-backdrop"></div>
    <div class="app-wrapper">
        <!-- Navegación Lateral (Sidebar) -->
        <aside class="app-sidebar">
            <a asp-controller="Home" asp-action="Dashboard" class="sidebar-brand">
                <span class="fs-4 text-warning">⚡</span>
                <span class="fw-bold tracking-tight">FIRMEZA</span>
                <span class="badge bg-primary ms-auto" style="font-size: 0.65rem;">Admin</span>
            </a>

            <!-- Usuario Activo -->
            <div class="sidebar-user d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; flex-shrink: 0;">
                    @(User.Identity.Name?[..1].ToUpper() ?? "A")
                </div>
                <div class="text-truncate">
                    <div class="fw-semibold text-white small text-truncate">@User.Identity.Name</div>
                    <div class="text-muted" style="font-size: 0.72rem;">Rol: Administrador</div>
                </div>
            </div>

            <!-- Menú Principal -->
            <ul class="sidebar-menu">
                <li class="sidebar-heading">Gestión Principal</li>
                <li>
                    <a asp-controller="Home" asp-action="Dashboard" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Panel / Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Productos" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Clientes" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Clientes</span>
                    </a>
                </li>

                <li class="sidebar-heading">Acceso & Clientes</li>
                <li>
                    <a href="/spa/index.html" class="sidebar-link" title="Abrir interfaz Angular SPA">
                        <i class="bi bi-window-sidebar text-info"></i>
                        <span>Cliente SPA (Angular)</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="Privacy" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Privacy" ? "active" : "")">
                        <i class="bi bi-shield-check"></i>
                        <span>Privacidad & Datos</span>
                    </a>
                </li>
            </ul>

            <!-- Pie de la Barra Lateral -->
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" class="w-100 m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2 rounded-3 py-2">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="fw-semibold">Cerrar Sesión</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Área Principal con Encabezado y Pie de Página -->
        <div class="app-main">
            <!-- Encabezado Superior (Header) -->
            <header class="app-header">
                <div class="d-flex align-items-center gap-3">
                    <button id="sidebarToggle" class="btn btn-light btn-sm rounded-3 border d-lg-none" type="button" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-none d-sm-block">
                        <span class="text-muted small fw-medium">Sistema de Gestión Comercial y Despacho de Materiales</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 d-none d-md-inline-flex align-items-center gap-1">
                        <i class="bi bi-circle-fill text-success" style="font-size: 0.5rem;"></i>
                        <span>Servidor Conectado</span>
                    </span>

                    <div class="dropdown">
                        <button class="btn btn-light btn-sm rounded-pill px-3 border d-flex align-items-center gap-2 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span class="small fw-semibold">@User.Identity.Name</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                            <li><h6 class="dropdown-header">Usuario Administrador</h6></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                            <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Productos</a></li>
                            <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people me-2"></i> Clientes</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Contenido Dinámico -->
            <main class="app-content">
                @RenderBody()
            </main>

            <!-- Pie de Página (Footer) -->
            <footer class="app-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    &copy; 2026 <strong class="text-dark">Firmeza</strong> - Gestión y Despacho de Materiales. Todos los derechos reservados.
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-light text-muted border">Versión 2.0</span>
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Privacidad</a>
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <!-- Layout Público / Autenticación (Header clásico + Footer) -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2">
            <div class="container px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-white" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 text-warning">⚡</span>
                    <span class="tracking-wide">FIRMEZA</span>
                </a>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-shield-check me-1"></i> Privacidad
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 flex-grow-1 min-vh-100">
        @RenderBody()
    </main>

    <footer class="app-footer text-center">
        <div class="container">
            <small>&copy; 2026 <strong class="text-dark">Firmeza</strong> - Sistema de Gestión Comercial y Logística.</small>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>