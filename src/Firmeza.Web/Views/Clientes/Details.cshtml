@model ClienteDto
@{
    ViewData["Title"] = $"Detalle del Cliente: {Model.RazonSocial} - Firmeza";
    var colCulture = new CultureInfo("es-CO");
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <!-- Navigation breadcrumb / back link -->
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-link text-decoration-none p-0 text-muted d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Volver al Directorio de Clientes
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-light border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-lg bg-info text-white rounded-4 d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 56px; height: 56px;">
                        @(string.IsNullOrEmpty(Model.RazonSocial) ? "C" : Model.RazonSocial.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <span class="badge bg-secondary-subtle text-dark mb-1 font-monospace">NIT / Doc: @Model.DocumentoIdentidad</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.RazonSocial</h3>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 bg-light border h-100">
                            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Correo Electrónico</span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-envelope-fill text-primary"></i>
                                <span class="fw-semibold text-dark">@Model.Email</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 bg-light border h-100">
                            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Teléfono de Contacto</span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-telephone-fill text-success"></i>
                                <span class="fw-semibold text-dark">@Model.Telefono</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-4 bg-light border">
                            <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Dirección de Despacho / Obra</span>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                <span class="fw-semibold text-dark">@Model.DireccionEnvio</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 h-100">
                            <span class="text-primary small fw-semibold text-uppercase d-block mb-1">Total de Facturas / Órdenes</span>
                            <h3 class="fw-bold text-primary mb-0">@Model.TotalCompras</h3>
                            <small class="text-muted">Pedidos procesados en la plataforma</small>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 bg-success bg-opacity-10 border border-success border-opacity-25 h-100">
                            <span class="text-success small fw-semibold text-uppercase d-block mb-1">Facturación Total Histórica</span>
                            <h3 class="fw-bold text-success mb-0">@Model.MontoTotalComprado.ToString("C0", colCulture)</h3>
                            <small class="text-muted">Total facturado en COP</small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-3">
                        <i class="bi bi-trash me-1"></i> Eliminar Cliente
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
