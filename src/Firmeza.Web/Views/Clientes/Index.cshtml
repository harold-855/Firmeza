@model ClienteIndexViewModel
@{
    ViewData["Title"] = "Directorio de Clientes - Firmeza";
    var colCulture = new CultureInfo("es-CO");
}

<!-- Flash Notifications -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-info bg-opacity-10 text-info rounded-4 shadow-sm">
            <i class="bi bi-people-fill fs-2"></i>
        </div>
        <div>
            <h2 class="fw-bold mb-1 text-dark">Directorio de Clientes</h2>
            <p class="text-muted mb-0">Gestión de empresas constructoras, contratistas y clientes particulares.</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span class="fw-semibold">Nuevo Cliente</span>
        </a>
    </div>
</div>

<!-- KPI Mini-Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 bg-white rounded-4 p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Clientes Registrados</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalClientes</h3>
                </div>
                <div class="p-3 rounded-circle bg-light text-primary fs-4">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 bg-white rounded-4 p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Con Órdenes Activas</span>
                    <h3 class="fw-bold mb-0 text-success">@Model.ClientesConCompras</h3>
                </div>
                <div class="p-3 rounded-circle bg-success bg-opacity-10 text-success fs-4">
                    <i class="bi bi-bag-check"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 bg-white rounded-4 p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Facturación Acumulada</span>
                    <h3 class="fw-bold mb-0 text-primary">@Model.MontoTotalAcumulado.ToString("C0", colCulture)</h3>
                </div>
                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-4">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filtering Card -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-4">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <!-- Search term (Nombre / Razón Social o Documento) -->
                <div class="col-12 col-lg-5">
                    <label class="form-label small fw-bold text-muted">Búsqueda General (Nombre o NIT)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control bg-light border-start-0" placeholder="Nombre empresa, NIT, email, teléfono..." />
                    </div>
                </div>

                <!-- Documento specific filter -->
                <div class="col-6 col-lg-3">
                    <label class="form-label small fw-bold text-muted">Documento / NIT exacto</label>
                    <input type="text" name="Documento" value="@Model.Filter.Documento" class="form-control bg-light" placeholder="Ej: 900123456-1" />
                </div>

                <!-- Ordenamiento -->
                <div class="col-6 col-lg-2">
                    <label class="form-label small fw-bold text-muted">Ordenar por</label>
                    <select name="OrderBy" class="form-select bg-light">
                        <option value="nombre_asc" selected="@(Model.Filter.OrderBy == "nombre_asc" || string.IsNullOrEmpty(Model.Filter.OrderBy))">Razón Social (A-Z)</option>
                        <option value="nombre_desc" selected="@(Model.Filter.OrderBy == "nombre_desc")">Razón Social (Z-A)</option>
                        <option value="documento_asc" selected="@(Model.Filter.OrderBy == "documento_asc")">Documento (0-9)</option>
                        <option value="documento_desc" selected="@(Model.Filter.OrderBy == "documento_desc")">Documento (9-0)</option>
                        <option value="ventas_desc" selected="@(Model.Filter.OrderBy == "ventas_desc")">Mayor N° de Compras</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-12 col-lg-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3">
                        <i class="bi bi-funnel-fill me-1"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-dark">Listado de Clientes</h5>
            <small class="text-muted">Se encontraron <strong>@Model.Clientes.Count()</strong> cliente(s)</small>
        </div>
    </div>
    <div class="card-body p-4 pt-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Cliente / Razón Social</th>
                        <th>Documento / NIT</th>
                        <th>Contacto</th>
                        <th>Dirección de Despacho</th>
                        <th class="text-center">Compras</th>
                        <th class="text-end">Total Comprado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        @foreach (var c in Model.Clientes)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                            @(string.IsNullOrEmpty(c.RazonSocial) ? "C" : c.RazonSocial.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@c.Id" class="fw-bold text-dark text-decoration-none hover-primary">
                                                @c.RazonSocial
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@c.DocumentoIdentidad</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <div><i class="bi bi-telephone me-1 text-muted"></i>@c.Telefono</div>
                                        <div class="text-muted"><i class="bi bi-envelope me-1 text-muted"></i>@c.Email</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted text-truncate d-inline-block" style="max-width: 220px;" title="@c.DireccionEnvio">
                                        <i class="bi bi-geo-alt me-1 text-secondary"></i>@c.DireccionEnvio
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                                        @c.TotalCompras factura(s)
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    @c.MontoTotalComprado.ToString("C0", colCulture)
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-secondary" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                                No se encontraron clientes con los criterios de búsqueda ingresados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
